@model IEnumerable<ShowProductViewModel>

@{
    ViewData["Title"] = "مدیریت محصولات";
}

<h1>مدیریت محصولات</h1>

<p>
    <a asp-action="Create" class="btn btn-outline-success">افزودن محصول </a>
</p>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ImageName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Tags)
            </th>
            <th>
                سر گروه
            </th>
            <th>
                زیر گروه
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreateDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ModifiDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Available)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Popularproduct)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Bestseller)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsDelete)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <img src="/ProductImage/@item.ImageName" width="50" alt="Alternate Text" />
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Tags)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Group.GroupTitle)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SubGroup.SubGroupTitle)
                </td>
                <td>
                    @item.CreateDate.ToShamsi()
                </td>
                <td>
                    @item.ModifiDate?.ToShamsi()
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Available)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Popularproduct)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Bestseller)
                </td>


                <td>
                    @Html.DisplayFor(modelItem => item.IsDelete)
                </td>

                <td class="d-flex gap-1">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">ویرایش</a> |
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">جزئیات</a> |
                    <a onclick="DeleteProduct(@item.Id)" class="btn btn-sm btn-outline-danger">حذف</a>
                </td>

            </tr>
        }
    </tbody>
</table>
@section Scripts
{
    <script>
        function DeleteProduct(productId) {

            Swal.fire({
                title: "آیا از انجام این عملیات مطمئن هستید؟?",
                icon:'question',
                showCancelButton: true,
                confirmButtonText: "تأیید",

            }).then((result) => {

                if (result.isConfirmed) {
                    location.href = "/Admin/Products/Delete?id=" + productId
                }
            });
        }
    </script>
}