@model CreateProductGroupViewModel



<form asp-action="Create" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="GroupTitle" class="control-label"></label>
        <input asp-for="GroupTitle" class="form-control" />
        <span asp-validation-for="GroupTitle" class="text-danger"></span>
    </div>
    <div class="form-group">
        <div class="form-group">
            <label asp-for="GroupName" class="control-label"></label>
            <input type="file" asp-for="Image" id=" ImgUpload" onchange="ImgPre(this)" />
            <br />
            <img id="ImgPreview" width="50" />
        </div>
    </div>


    <div class="form-group">
        <input type="submit" value="Create" class="btn btn-success" />
    </div>
</form>



@section Scripts
{
    <script>
        function ImgPre(input) {
            if (input.files[0]) {
                var uploadimg = new FileReader();
                uploadimg.onload = function (displayimg) {
                    $("#ImgPreview").attr('src', displayimg.target.result);
                }
                uploadimg.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
