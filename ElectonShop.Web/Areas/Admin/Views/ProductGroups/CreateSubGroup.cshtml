@model CreateSubgroupViewModel

@{
    ViewData["Title"] = "افزودن";
}

<h1>افزودن زیر گروه</h1>


<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="CreateSubGroup" >
          

            <input type="hidden" asp-for="GroupId" />
    
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="SubgroupTitle" class="control-label"></label>
                <input asp-for="SubgroupTitle" class="form-control" />
                <span asp-validation-for="SubgroupTitle" class="text-danger"></span>
            </div>
     


            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-success" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

