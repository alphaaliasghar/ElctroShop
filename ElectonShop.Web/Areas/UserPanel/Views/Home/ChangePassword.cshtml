@model ChangePaswordViewModel
@{
    ViewData["Title"] = "ChangePassword";
}

<section class="breadcrumb-area">
    <div class="container">
        <div class="row">
            <div class="col">
                <div class="breadcrumb-index">
                    <!-- breadcrumb-list start -->
                    <ul class="breadcrumb-ul">
                        <li class="breadcrumb-li">
                            <a class="breadcrumb-link" href="index.html"> خانه</a>
                        </li>
                        <li class="breadcrumb-li">
                            <span class="breadcrumb-text">تغییر کلمه عبور</span>
                        </li>
                    </ul>
                    <!-- breadcrumb-list end -->
                </div>
            </div>
        </div>
    </div>
</section>

<section class="customer-page section-ptb">
    <div class="container">
        <div class="row">
            <div class="col">
                <!-- account login title start -->
                <div class="log-acc" id="CustomerLoginForm">
                    <div class="section-capture">
                        <div class="section-title">
                            <h2 data-animate="animate__fadeInUp" class="animate__fadeInUp animate__animated"><span> ویرایش کلمه عبور </span></h2>
                        </div>
                    </div>
                    <!-- account login title end -->
                    <!-- account login start  -->
                    <div class="log-acc-page">
                        <div class="contact-form-list">
                            <form asp-action="ChangePassword" method="post">

                                @switch (ViewBag.Result)
                                {
                                    case ResultChangePassword.Success:
                                        {
                                            TempData["SuccessMessage"] = "ویرایش کلمه عبور با موفقیت انجام شد";

                                            <script>
                                                setTimeout(function () {
                                                    window.location.href = 'https://localhost:7037/login-user'; 
                                                }, 2000);
                                            </script>
                                            break;
                                        }
                                    case ResultChangePassword.OldPasswordNotValid:
                                        {
                                            TempData["WarningMessage"] = "کلمه عبور فعلی اشتباه است";
                                            break;
                                        }


                                    case ResultChangePassword.Error:
                                        {
                                            TempData["ErrorMessage"] = "مشکلی پیش آمده  لطفا دوباره امتحان کنید";
                                            break;
                                        }
                                }

                                <ul class="form-fill">
                                    <li class="form-fill-li Password animate__fadeInUp animate__animated" data-animate="animate__fadeInUp">
                                        <label asp-for="OldPasword"> </label>
                                        <input asp-for="OldPasword" type="password" placeholder=" کلمه عبور فعلی">
                                    </li>
                                    <li class="form-fill-li Password animate__fadeInUp animate__animated" data-animate="animate__fadeInUp">
                                        <label asp-for="Password"> </label>
                                        <input asp-for="Password" type="password" placeholder=" کلمه عبور جدید">
                                    </li>
                                    <li class="form-fill-li Password animate__fadeInUp animate__animated" data-animate="animate__fadeInUp">
                                        <label asp-for="Repassword"> </label>
                                        <input asp-for="Repassword" type="password" placeholder=" تکرار کلمه عبورجدید">
                                    </li>
                                </ul>
                                <div class="form-action-button animate__fadeInUp animate__animated" data-animate="animate__fadeInUp">
                                    <div class="button-forget">
                                        <button type="submit" class="btn btn-style2"> ویرایش کلمه عبور</button>

                                    </div>
                                </div>
                            </form>
                        </div>

                    </div>
                </div>


                <!-- account login end -->
            </div>
            <!-- account login start -->
        </div>
    </div>

</section>

