@model EditInformationViewModel

<section class="section-ptb">
    <div class="container">
        <div class="row ">
            <div class="col-12">
                <div class="checkout-area">
                    <div class="billing-area">
                        <form asp-action="EditInformation" enctype="multipart/form-data" method="post">
                            
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="AvatarName" />
                            <input type="hidden" asp-for="Modifidate" />

                            <h2 data-animate="animate__fadeInUp" class="animate__fadeInUp animate__animated"> ویرایش حساب کاربری</h2>
                            <div class="billing-form">
                                <ul class="input-2 animate__fadeInUp animate__animated" data-animate="animate__fadeInUp">
                                    <li class="billing-li">
                                        <label asp-for="UserName"></label>
                                        <input asp-for="UserName" type="text" placeholder="نام">
                                    </li>

                                </ul>

                                <ul class="input-2" data-animate="animate__fadeInUp">
                                    <li class="billing-li">
                                        <label asp-for="Email"> </label>
                                        <input asp-for="Email" type="text" placeholder="آدرس ایمیل">
                                    </li>

                                </ul>
                            </div>



                            <input asp-for="Avatar" type="file" id="  ImgUpload" onchange="ImgPre(this)" />
                            <img id="ImgPreview" src="/Avatar/@Model.AvatarName" width="100" />


                            <div class="button-forget">
                                <button type="submit" class="btn btn-style2"> ویرایش حساب کاربری</button>

                            </div>

                        </form>

                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
{
    <script>
        function ImgPre(input) {
            if (input.files[0]) {
                var uploadimg = new FileReader();
                uploadimg.onload = function (displayimg) {
                    $("#ImgPreview").attr('src', displayimg.target.result);
                }
                uploadimg.readAsDataURL(input.files[0]);
            }
        }
    </script>
}