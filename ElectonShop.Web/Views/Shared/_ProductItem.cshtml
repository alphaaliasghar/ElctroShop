@model ShowProductViewModel

<div class="swiper-slide" data-animate="animate__fadeInUp">
    <div class="single-product-wrap">
        <div class="product-image">
            <a  asp-controller="Product" asp-action="ShowProduct" asp-route-productId="@Model.Id"
               class="pro-img">
                <img src="/ProductImage/@Model.ImageName" class="img-fluid img1 mobile-img1" alt="p1">
                <img src="/ProductImage/@Model.ImageName" class="img-fluid img2 mobile-img2" alt="p2">
            </a>

        </div>
        <div class="product-content">

            <div class="product-title">
                <h6>
                    <a  asp-controller="Product" asp-action="ShowProduct" asp-route-productId="@Model.Id"> @Model.Title</a>
                </h6>
            </div>
            <div class="product-price">
                <div class="pro-price-box">
                    <span class="new-price">@Model.Price.ToString("0,#")تومان</span>

                </div>
            </div>
        </div>


    </div>
</div>
